Options -Indexes

# Protect hidden files from being viewed
<Files .*>
	Order Deny,Allow
	Deny From All
</Files>

# Turn on URL rewriting
RewriteEngine On

# Protect application and system files from being viewed
# Make an exception for the assets folder!
RewriteCond %{REQUEST_URI} ^/grge/(system|modules)/.* [NC]
RewriteRule .* - [F]

# Catch media querys
RewriteCond %{REQUEST_URI} !^/grge/(vendor)/.* [NC]
RewriteCond %{REQUEST_URI} \.(css|js|jpg|bmp|gif|png|ico|webp|eot|svg|ttf|woff)$ [NC]
RewriteRule (.*) application/assets/index.php/$1 [L]

# Allow any files or directories that exist to be displayed directly
RewriteCond %{REQUEST_URI} !^/vendor/.* [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite all other URLs to index.php/URL
RewriteRule .* index.php/$0 [PT]